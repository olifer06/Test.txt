
# Problem 3
# Student class using a dictionary for tuition rates

tuition_rates = {
    "I": 250,
    "O": 500,
    "X": 800,
    "G": 250
}


class Student:
    def __init__(self, first_name, last_name, district_code, credits):
        self.first_name = first_name
        self.last_name = last_name
        self.district_code = district_code
        self.credits = credits

    def calculate_tuition(self):
        rate = tuition_rates[self.district_code]
        tuition = self.credits * rate
        return tuition

    def display_student(self):
        print("Student:", self.first_name, self.last_name)
        print("District Code:", self.district_code)
        print("Enrolled Credits:", self.credits)
        print("Tuition Owed: $", format(self.calculate_tuition(), ",.2f"))
        print()


student1 = Student("James", "Anderson", "I", 12)
student2 = Student("Sarah", "Martinez", "O", 15)
student3 = Student("David", "Gonzales", "X", 9)
student4 = Student("Emily", "Samano", "G", 12)

student1.display_student()
student2.display_student()
student3.display_student()
student4.display_student()
