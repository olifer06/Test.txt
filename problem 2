# Problem 2 - Widget Pricing

quantity = int(input("Enter quantity of widgets: "))

if quantity > 10000:
    price = 10.00
elif quantity >= 5000:
    price = 20.00
else:
    price = 30.00

extended_price = quantity * price
tax = extended_price * 0.07
total = extended_price + tax

print()
print(f"{'Extended Price':<20}{'Tax':>12}{'Total':>12}")
print(f"{extended_price:<20.2f}{tax:>12.2f}{total:>12.2f}")