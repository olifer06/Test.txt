# Problem 5
# Calculate each student's average and the class averages

grades = {
    "Anderson": [87, 90, 85],
    "Taylor": [94, 88, 92],
    "Martinez": [76, 82, 79],
    "Thompson": [83, 85, 81],
    "White": [91, 93, 89],
    "Harris": [68, 74, 70],
    "Clark": [88, 86, 90],
    "Lewis": [79, 81, 77],
    "Walker": [96, 94, 98],
    "Hall": [85, 87, 83]
}


def calculate_averages(student_grades):
    student_averages = []

    for name in student_grades:
        total = 0

        for i in range(3):
            total = total + student_grades[name][i]

        average = total / 3
        student_averages.append([name, average])

    return student_averages


student_averages = calculate_averages(grades)

print(f"{'Student Name':<20}{'Grade 1':>10}"
      f"{'Grade 2':>10}{'Grade 3':>10}{'Average':>10}")
print("-" * 60)

grade1_total = 0
grade2_total = 0
grade3_total = 0
count = 0

for name in grades:
    grade1 = grades[name][0]
    grade2 = grades[name][1]
    grade3 = grades[name][2]

    student_average = (grade1 + grade2 + grade3) / 3

    print(f"{name:<20}{grade1:>10}{grade2:>10}"
          f"{grade3:>10}{student_average:>10.2f}")

    grade1_total = grade1_total + grade1
    grade2_total = grade2_total + grade2
    grade3_total = grade3_total + grade3
    count = count + 1

print("-" * 60)
print(f"{'Class Average':<20}{grade1_total / count:>10.2f}"
      f"{grade2_total / count:>10.2f}"
      f"{grade3_total / count:>10.2f}")