def compute_out_the_door_price(msrp, make, model, electric):
    if electric.upper() == "Y":
        discount_percent = 0.30
    elif make.lower() == "honda" and model.lower() == "accord":
        discount_percent = 0.10
    elif make.lower() == "toyota" and model.lower() == "rav4":
        discount_percent = 0.15
    else:
        discount_percent = 0.05

    discount = msrp * discount_percent
    discounted_price = msrp - discount
    sales_tax = discounted_price * 0.07
    out_the_door_price = discounted_price + sales_tax

    return out_the_door_price


total_msrp = 0
total_sales_price = 0

while True:
    answer = input("Do you want to enter an automobile? (Yes or No): ")

    if answer.upper() == "NO":
        break

    make = input("Enter make: ")
    model = input("Enter model: ")
    electric = input("Is it an electric vehicle? (Y or N): ")
    msrp = float(input("Enter MSRP: "))

    sales_price = compute_out_the_door_price(
        msrp, make, model, electric
    )

    print("Make:", make)
    print("Model:", model)
    print("Out-the-Door Price: ${:.2f}".format(sales_price))

    total_msrp += msrp
    total_sales_price += sales_price

print("Total MSRP: ${:.2f}".format(total_msrp))
print("Total Sales Price: ${:.2f}".format(total_sales_price))