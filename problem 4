# Problem 4 - CD Interest

principle = float(input("Enter principle amount: "))
years = int(input("Enter years to maturity: "))

if principle > 100000 and years == 5:
    interest_rate = 0.06
elif principle >= 50000 and principle <= 100000 and years == 10:
    interest_rate = 0.05
elif principle >= 50000 and principle <= 100000 and years == 5:
    interest_rate = 0.04
else:
    interest_rate = 0.02

interest = principle * interest_rate

print()
print(f"{'Principle':<15}{'Interest Rate':>15}{'First Year Interest':>22}")
print(f"${principle:<14.2f}{interest_rate * 100:>14.2f}%{interest:>20.2f}")
